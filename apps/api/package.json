{
  "name": "@overbookd/api",
  "version": "3.1.36",
  "description": "API pour le logiciel de gestion du festival des 24 heures de l'INSA",
  "author": "Club des 24 heures de l'INSA (https://www.24heures.org/)",
  "homepage": "https://gitlab.com/24-heures-insa/overbookd-mono",
  "license": "Apache-2.0",
  "private": true,
  "bugs": {
    "url": "https://gitlab.com/24-heures-insa/overbookd-mono/-/issues/new",
    "email": "contact-project+24-heures-insa-overbookd-mono-31598236-issue-@incoming.gitlab.com"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/24-heures-insa/overbookd-mono",
    "directory": "apps/api"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "pnpm prisma:generate && nest build",
    "build:ci": "pnpm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prune": "ts-prune --error --ignore 'index.ts|domains|libraries|generated|config.ts'",
    "start": "nest start --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:migrate:prod": "pnpm database:migrate && pnpm run start:prod",
    "start:prod": "node dist/src/main",
    "version:major": "pnpm version major --no-commit-hooks --no-git-checks --no-git-tag-version",
    "version:minor": "pnpm version minor --no-commit-hooks --no-git-checks --no-git-tag-version",
    "version:patch": "pnpm version patch --no-commit-hooks --no-git-checks --no-git-tag-version",
    "test:unit": "vitest --config ../../vitest.config.mts",
    "test:unit:ci": "vitest --config ../../vitest-ci.config.mts --watch=false",
    "prisma:generate": "npx prisma generate",
    "database:init": "pnpm prisma:generate && pnpm database:migrate && pnpm database:seed",
    "database:migrate": "npx prisma migrate deploy",
    "database:seed": "npx prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.3",
    "@nestjs/throttler": "6.7.1",
    "@overbookd/access-manager": "workspace:*",
    "@overbookd/alerts": "workspace:*",
    "@overbookd/assignment": "workspace:*",
    "@overbookd/charisma": "workspace:*",
    "@overbookd/configuration": "workspace:*",
    "@overbookd/contribution": "workspace:*",
    "@overbookd/csv": "workspace:*",
    "@overbookd/domain-events": "workspace:*",
    "@overbookd/festival-event": "workspace:*",
    "@overbookd/festival-event-constants": "workspace:*",
    "@overbookd/geo-location": "workspace:*",
    "@overbookd/http": "workspace:*",
    "@overbookd/list": "workspace:*",
    "@overbookd/logistic": "workspace:*",
    "@overbookd/oidc": "workspace:*",
    "@overbookd/pdf-book": "workspace:*",
    "@overbookd/permission": "workspace:*",
    "@overbookd/personal-account": "workspace:*",
    "@overbookd/preference": "workspace:*",
    "@overbookd/registration": "workspace:*",
    "@overbookd/signa": "workspace:*",
    "@overbookd/slugify": "workspace:*",
    "@overbookd/team": "workspace:*",
    "@overbookd/team-code": "workspace:*",
    "@overbookd/time": "workspace:*",
    "@overbookd/user": "workspace:*",
    "@overbookd/volunteer-availability": "workspace:*",
    "@overbookd/web-page": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ejs": "7.0.2",
    "express-basic-auth": "1.2.1",
    "html-to-pdfmake": "2.5.36",
    "ics": "3.12.1",
    "jsdom": "30.1.3",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "nodemailer": "10.2.1",
    "passport": "0.7.0",
    "passport-zitadel": "1.2.3",
    "pdfmake": "0.3.11",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/html-to-pdfmake": "2.4.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/pdfmake": "0.3.3",
    "@types/sanitize-html": "2.16.2",
    "prisma": "7.10.1",
    "source-map-support": "0.5.21",
